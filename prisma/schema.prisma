datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  passwordHash String
  name         String
  role         String          @default("student") // student, content_author, reviewer, administrator
  avatarUrl    String?
  status       String          @default("active") // active, suspended
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  profile      Profile?
  sessions     Session[]
  workspaces   Workspace[]
  submissions  Submission[]
  evaluations  Evaluation[]
  portfolio    PortfolioItem[]
  auditLogs    AuditLog[]

  @@index([email])
  @@index([role])
}

model Profile {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline         String?
  bio              String?
  experienceLevel  String   @default("beginner") // beginner, intermediate, advanced
  githubUsername   String?
  linkedinUrl      String?
  portfolioWebsite String?
  preferences      String? // JSON string: notification settings, UI themes
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([token])
  @@index([email])
}

// 1. Career Family (e.g. "Data & Artificial Intelligence", "Engineering & Architecture")
model CareerFamily {
  id           String       @id @default(cuid())
  slug         String       @unique
  name         String
  description  String
  icon         String?
  displayOrder Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  professions  Profession[]

  @@index([slug])
}

// 2. Profession (e.g. "Machine Learning Engineering", "Software Engineering")
model Profession {
  id             String        @id @default(cuid())
  careerFamilyId String?
  careerFamily   CareerFamily? @relation(fields: [careerFamilyId], references: [id], onDelete: SetNull)
  slug           String        @unique
  name           String
  category       String
  description    String
  icon           String?
  status         String        @default("published") // draft, review, approved, published, archived
  isPublished    Boolean       @default(true)
  displayOrder   Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  roles          Role[]
  tasks          Task[]

  @@index([slug])
  @@index([careerFamilyId])
  @@index([status])
}

// 3. Role (e.g. "Associate MLOps Engineer", "Junior Backend Engineer")
model Role {
  id               String       @id @default(cuid())
  professionId     String
  profession       Profession   @relation(fields: [professionId], references: [id], onDelete: Cascade)
  slug             String       @unique
  title            String
  level            String       @default("junior") // junior, mid, senior, lead, principal
  summary          String
  description      String
  marketDemand     String?
  responsibilities String // JSON array string
  status           String       @default("published") // draft, review, approved, published, archived
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  skills           RoleSkill[]
  simulations      Simulation[]
  tasks            Task[]

  @@index([slug])
  @@index([professionId])
  @@index([status])
}

// 4. Skill
model Skill {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  category    String // Language, Framework, Database, DevOps, Architecture, MLOps
  description String?
  icon        String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  roles       RoleSkill[]
  taskSkills  TaskSkill[]

  @@index([slug])
  @@index([category])
}

model RoleSkill {
  roleId  String
  role    Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  skillId String
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([roleId, skillId])
}

// 5. Company (e.g. "OmniRetail Marketplace", "FinFlow Technologies")
model Company {
  id                   String       @id @default(cuid())
  name                 String
  slug                 String       @unique
  industry             String // Fintech, E-Commerce, Healthtech, Cloud Infrastructure
  size                 String // Series B (85 employees), Enterprise (5000+)
  description          String
  culture              String?
  techStack            String // JSON array string
  logoUrl              String?
  architectureOverview String? // Markdown summary
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  teams                Team[]
  simulations          Simulation[]
  tasks                Task[]

  @@index([slug])
}

// 6. Team (e.g. "ML Platform & Governance", "Core Payments Platform")
model Team {
  id            String       @id @default(cuid())
  companyId     String
  company       Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name          String
  charter       String
  leadName      String
  leadRole      String
  slackChannels String? // JSON array string
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  simulations   Simulation[]

  @@index([companyId])
}

// 7. Simulation
model Simulation {
  id                    String          @id @default(cuid())
  roleId                String
  role                  Role            @relation(fields: [roleId], references: [id], onDelete: Cascade)
  companyId             String
  company               Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  teamId                String
  team                  Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  title                 String
  slug                  String          @unique
  summary               String
  businessScenario      String // Markdown context of business problem
  difficulty            String          @default("Production simulation") // Guided, Assisted, Independent, Production simulation, Ownership
  estimatedHours        Int             @default(4)
  prerequisiteKnowledge String? // JSON array string
  status                String          @default("published") // draft, review, approved, published, archived
  isPublished           Boolean         @default(true)
  version               String          @default("1.0.0")
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  phases                Phase[]
  workspaces            Workspace[]
  portfolioItems        PortfolioItem[]

  @@index([slug])
  @@index([roleId])
  @@index([companyId])
  @@index([status])
}

// 8. Phase (Sprint / Phase within Simulation)
model Phase {
  id                         String     @id @default(cuid())
  simulationId               String
  simulation                 Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  title                      String
  slug                       String
  orderIndex                 Int        @default(0)
  summary                    String?
  businessObjective          String
  architectureDecisionRecord String? // ADR markdown
  repositoryTemplateUrl      String?
  stagingUrl                 String?
  status                     String     @default("published") // draft, review, approved, published, archived
  createdAt                  DateTime   @default(now())
  updatedAt                  DateTime   @updatedAt
  tasks                      Task[]

  @@index([simulationId])
  @@index([status])
}

// 9. Task (Reusable, rich data-driven structure)
model Task {
  id                       String           @id @default(cuid())
  phaseId                  String
  phase                    Phase            @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  professionId             String?
  profession               Profession?      @relation(fields: [professionId], references: [id], onDelete: SetNull)
  roleId                   String?
  role                     Role?            @relation(fields: [roleId], references: [id], onDelete: SetNull)
  companyId                String?
  company                  Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)

  ticketKey                String // e.g. "ML-101", "FF-104"
  title                    String
  slug                     String
  orderIndex               Int              @default(0)
  type                     String // INVESTIGATION, IMPLEMENTATION, TESTING, CODE_REVIEW, DEPLOYMENT, MONITORING_INCIDENT
  difficulty               String           @default("Production simulation") // Guided, Assisted, Independent, Production simulation, Ownership

  businessContext          String // Markdown explanation of business impact
  objective                String // Primary mission statement
  prerequisites            String? // JSON array of required knowledge / task prerequisites
  tools                    String? // JSON array of tools: ["Python", "MLflow", "Docker", "Evidently AI"]

  environmentConfiguration String? // JSON object: container runtime, base image, cpu, ram, envVars, ports, services
  startingState            String? // JSON object: branch, templateRepo, initialFiles, seedDatasets, dirtyStateDescription
  requirements             String? // JSON array of technical specifications
  constraints              String? // JSON array of latency, SLA, resource, and architectural constraints
  deliverables             String? // JSON array of deliverables expected from the student

  automatedTests           String? // JSON object: command, testFiles, timeoutSec
  hiddenTests              String? // JSON object: evaluation test suites & acceptance benchmarks
  rubric                   String? // JSON array: criteria, weight, evaluation guidelines
  mentorConfiguration      String? // JSON object: AI persona guidelines, strictness, allowable hints
  failureScenarios         String? // JSON array: synthetic incident / alert triggers
  completionCriteria       String? // JSON array: exact conditions to unlock next task or complete phase
  portfolioEvidence        String? // JSON object: schema for verified evidence dossier

  status                   String           @default("published") // draft, review, approved, published, archived
  estimatedMinutes         Int              @default(45)
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  skills                   TaskSkill[]
  submissions              Submission[]
  dependencies             TaskDependency[] @relation("TaskDependencies")
  dependents               TaskDependency[] @relation("DependentTasks")

  @@index([phaseId])
  @@index([ticketKey])
  @@index([status])
  @@index([difficulty])
}

model TaskSkill {
  taskId  String
  task    Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  skillId String
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([taskId, skillId])
}

// 10. Task Dependencies (Prerequisites, Sequential, Branching, Unlock & Completion conditions)
model TaskDependency {
  id                  String  @id @default(cuid())
  taskId              String
  task                Task    @relation("TaskDependencies", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnTaskId     String
  dependsOnTask       Task    @relation("DependentTasks", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)
  dependencyType      String  @default("PREREQUISITE") // PREREQUISITE, SEQUENTIAL, BRANCHING, OPTIONAL
  unlockCondition     String? // JSON string: e.g. { "minScore": 80, "branch": "A" }
  completionCondition String? // JSON string: e.g. { "testCoverageMin": 85 }

  @@unique([taskId, dependsOnTaskId])
}

model Workspace {
  id                 String     @id @default(cuid())
  userId             String
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  simulationId       String
  simulation         Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  status             String     @default("PENDING") // PENDING, RUNNING, PAUSED, TERMINATED
  devcontainerConfig String? // JSON string
  lastActivityAt     DateTime   @default(now())
  expiresAt          DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([userId])
  @@index([simulationId])
}

model Submission {
  id                String       @id @default(cuid())
  taskId            String
  task              Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId            String
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchName        String?
  pullRequestNumber Int?
  pullRequestUrl    String?
  commitSha         String?
  status            String       @default("DRAFT") // DRAFT, SUBMITTED, IN_REVIEW, APPROVED, REJECTED
  diffSummary       String?
  studentNotes      String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  evaluations       Evaluation[]

  @@index([taskId])
  @@index([userId])
}

model Evaluation {
  id           String     @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewerId   String?
  reviewer     User?      @relation(fields: [reviewerId], references: [id], onDelete: SetNull)
  isAiReview   Boolean    @default(true)
  score        Int? // 0-100
  rubricScores String? // JSON string
  feedback     String // Structured markdown review
  status       String     @default("COMPLETED") // PENDING, COMPLETED
  approved     Boolean    @default(false)
  createdAt    DateTime   @default(now())

  @@index([submissionId])
}

model PortfolioItem {
  id                  String     @id @default(cuid())
  userId              String
  user                User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  simulationId        String
  simulation          Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  title               String
  slug                String
  summary             String
  verificationDossier String // JSON string: cryptographic audit trail
  repositoryUrl       String?
  liveDemoUrl         String?
  skillsAcquired      String // JSON array string
  isPublic            Boolean    @default(true)
  publishedAt         DateTime   @default(now())
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  @@index([userId])
  @@index([simulationId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String // USER_REGISTERED, LOGIN_SUCCESS, PR_SUBMITTED, etc.
  entityType String // User, Submission, Workspace, Simulation, Task, etc.
  entityId   String?
  metadata   String? // JSON string
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([entityType])
}
