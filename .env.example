# Environment variables for [workup]
# Database configuration (SQLite for local zero-dependency development; PostgreSQL supported in production)
DATABASE_URL="file:./dev.db"

# JWT Secret for Session Management (Minimum 32 characters)
JWT_SECRET="workup-super-secret-dev-jwt-key-change-in-production-min-32-chars"

# App Environment
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="workup"

# Logging Level (debug, info, warn, error)
LOG_LEVEL="info"
